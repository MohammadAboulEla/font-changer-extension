{
	"name":           "Font Changer",
	"version":        "4.0.0",
	"description":    "Change the font on any website. Supports Google Fonts and system fonts.",
	"content_scripts":[
		{
			"matches":   ["<all_urls>"],
			"js":        ["js/cs.js"],
			"all_frames":true,
			"run_at":    "document_start"
		}
	],
	"permissions":    [
		"storage"
	],
	"host_permissions": [
		"<all_urls>"
	],
	"background":             {
		"service_worker": "js/background.js"
	},
	"action":         {
		"default_icon": "img/logo.png",
		"default_title":"Font Changer",
		"default_popup": "popup.html"
	},
	"icons":                  {
		"48":"img/logo48.png",
		"128":"img/logo.png"
	},

	"manifest_version":       3
}